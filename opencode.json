{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false,
    "prune": false
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1",
        "timeout": false,
        "headerTimeout": false,
        "chunkTimeout": false
      },
      "models": {
        "qwen3.8-gsq-rco": {
          "name": "Qwen3.8-gsq-rco",
          "limit": {
            "context": 49152,
            "output": 16384
          },
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  },
  "model": "ollama/qwen3.8-gsq-rco",
  "plugin": [
    "@cortexkit/opencode-magic-context@latest"
  ]
}
