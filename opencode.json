{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false
  },
  "providers": {
    "llama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "settings": {
        "baseURL": "http://host.docker.internal:11434/v1",
        "timeout": false,
        "headerTimeout": false,
        "chunkTimeout": false
      },
      "models": {
        "Qwen3.8-gsq-rco": {
          "name": "Qwen3.8-gsq-rco",
          "limit": {
            "context": 98304,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true
            }
          }
        }
      }
    }
  },
  "model": "llama/Qwen3.8-gsq-rco",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "plugins": [
    "@cortexkit/opencode-magic-context@0.49.50"
  ],
  "experimental": {
    "todo": true
  }
}
